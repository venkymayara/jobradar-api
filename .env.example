# Production profile values. Development uses the integrated Windows-authentication URL
# configured in application-dev.properties. Do not commit real credentials.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ven_db;encrypt=true;trustServerCertificate=false
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4200
JWT_SECRET=replace-with-at-least-32-random-bytes-from-a-secret-manager
